# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local logs
dev_smoke*.log*
*.log
.dev.log
.tmp-*
tmp-*
_tmp_*
delete_test
tsconfig.tmp.json
tmp_audit.py
temp_write_test.txt
nul

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large/local datasets (keep out of git; mount into container from host)
/public/data/**/*.csv
/public/data/**/*.duckdb
/public/data/data_manifest*.json
/public/data/*duckdb_export*.json
/public/data/*duckdb_export*.sql
# runtime dataset allowlist for Vercel (CSV backend)
!/public/data/stock_metadata_2018_2025.csv
!/public/data/ohlcv_2018_2025.csv
!/public/data/Market_Indices_Daily_2020_2025.csv
!/public/data/industry_by_symbol_2018_2025.csv
!/public/data/HOSE_VERIFIED_BalanceSheet_Quarterly_2018_2025.csv
!/public/data/HOSE_VERIFIED_IncomeStatement_Quarterly_2018_2025.csv
!/public/data/HOSE_VERIFIED_CashFlow_Quarterly_2018_2025.csv
!/public/data/data_manifest.json
!/public/data/data_manifest_2018_2025.json

# generated reports
/artifacts/

# playwright
/playwright-report/
/test-results/
/playwright/.cache/
.pw-out*
.pw-test-results*

# local CI/build/cache artifacts
/.next-ci-build-*/
/.next-webpack-build-*/
/.pnpm-store/
/.pw-browsers/
lint-report*.json
