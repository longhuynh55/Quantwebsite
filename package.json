{
  "name": "quant-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:prepare:2018_2025": "node scripts/prepare_data_2018_2025.mjs",
    "smoke:docker": "node scripts/smoke.mjs",
    "qa:docker": "node scripts/qa.mjs",
    "docker:up": "docker compose up -d app",
    "docker:logs": "docker compose logs -f app",
    "docker:smoke": "docker compose run --rm smoke",
    "docker:smoke:api": "docker compose run --rm -e SMOKE_INCLUDE_UI=false smoke",
    "docker:qa": "docker compose run --rm qa",
    "docker:qa:api": "docker compose run --rm -e SMOKE_INCLUDE_UI=false qa",
    "docker:up:prod": "docker compose --profile prod up -d app-prod",
    "docker:logs:prod": "docker compose --profile prod logs -f app-prod",
    "docker:smoke:prod": "docker compose --profile prod run --rm smoke-prod",
    "docker:smoke:prod:api": "docker compose --profile prod run --rm -e SMOKE_INCLUDE_UI=false smoke-prod",
    "docker:qa:prod": "docker compose --profile prod run --rm qa-prod",
    "docker:qa:prod:api": "docker compose --profile prod run --rm -e SMOKE_INCLUDE_UI=false qa-prod",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.1",
    "@tanstack/react-query": "^5.28.4",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lightningcss": "^1.31.1",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.358.0",
    "next": "16.1.6",
    "papaparse": "^5.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "technicalindicators": "^3.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
