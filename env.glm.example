# Copy to .env.glm (do NOT commit .env.glm)

# === OpenRouter (recommended for this project) ===
# Required to enable assistant model calls via OpenRouter.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional metadata headers (recommended)
# OPENROUTER_HTTP_REFERER=http://localhost:3010
# OPENROUTER_X_TITLE=QuantVN

# Optional model overrides (defaults shown)
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_SECONDARY_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_TERTIARY_MODEL=stepfun/step-3.5-flash:free

# === GLM provider (optional fallback chain) ===
# GLM_API_KEY=your_glm_key_here
# GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# GLM_MODEL=glm-4.7-flash

# === OpenAI fallback (optional) ===
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

